# Laravel API - the Vite dev server proxies /api and /storage here
VITE_BACKEND_URL=http://127.0.0.1:8000

# Reverb WebSocket - the Vite dev server proxies /app here
VITE_REVERB_URL=http://127.0.0.1:8080
# Copy REVERB_APP_KEY from Backend/.env. Empty = realtime off (pages still work, reload to refresh).
VITE_REVERB_APP_KEY=

# Optional: connect straight to Reverb instead of through the /app proxy
# VITE_REVERB_HOST=127.0.0.1
# VITE_REVERB_PORT=8080

# Map: default is the OpenFreeMap vector map (OpenStreetMap data, no key) with Vietnamese names and Hoang Sa / Truong Sa
# labelled as Vietnam. Setting VITE_MAP_TILE_URL switches to plain raster tiles, which show foreign claims over both archipelagos.
# tile.openstreetmap.org is DNS-blocked on some VN ISPs.
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
