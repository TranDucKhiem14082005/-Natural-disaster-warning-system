# Laravel API - the Vite dev server proxies /api and /storage here
VITE_BACKEND_URL=http://127.0.0.1:8000

# Reverb WebSocket - the Vite dev server proxies /app here
VITE_REVERB_URL=http://127.0.0.1:8080
# Copy REVERB_APP_KEY from Backend/.env. Empty = realtime off (pages still work, reload to refresh).
VITE_REVERB_APP_KEY=

# Optional: connect straight to Reverb instead of through the /app proxy
# VITE_REVERB_HOST=127.0.0.1
# VITE_REVERB_PORT=8080
