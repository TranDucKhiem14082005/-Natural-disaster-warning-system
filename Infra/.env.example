# Copy to Infra/.env (gitignored) and fill the secrets. Never commit Infra/.env.

COMPOSE_PROJECT_NAME=disaster-warning
IMAGE_TAG=local

# Ports on the host
HTTP_PORT=8000
PMA_PORT=8081
DB_HOST_PORT=3307

# Laravel
APP_ENV=production
APP_DEBUG=false
# Generate: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# MariaDB
DB_DATABASE=disaster_warning
DB_USERNAME=dws
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Reverb (WebSocket). Generate key/secret: openssl rand -hex 16
REVERB_APP_ID=dws
REVERB_APP_KEY=
REVERB_APP_SECRET=

# Mail (log = write to container log; set smtp + MAIL_* to send for real)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com

# External data sources
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
USGS_FEED_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
ORS_API_KEY=
RAIN_ALERT_THRESHOLD_MM=100
